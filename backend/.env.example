# Copy to .env and fill in real values. Never commit .env.

# Supabase Postgres (async driver required)
# App runtime: pooled port 6543. Alembic migrations: direct port 5432.
DATABASE_URL=postgresql+asyncpg://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres

# Supabase project (optional — for storage buckets)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_STORAGE_BUCKET_DOCS=
SUPABASE_STORAGE_BUCKET_IMAGES=

# Neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=veritas-neo4j

# LLM Providers (Groq or Anthropic — leave key empty to run pipeline in offline/deterministic mode)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Auth
JWT_SECRET=change-me-in-production
JWT_EXPIRE_MINUTES=720
DEMO_USERNAME=demo
DEMO_PASSWORD=veritas

# Storage / app
STORAGE_DIR=./uploads
CORS_ORIGINS=http://localhost:3000
ENVIRONMENT=development
