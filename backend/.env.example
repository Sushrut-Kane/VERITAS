# Copy to .env and fill in real values. Never commit .env.

# PostgreSQL (async driver required)
DATABASE_URL=postgresql+asyncpg://veritas:veritas@localhost:5432/veritas

# Neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=veritas-neo4j

# Anthropic (leave key empty to run pipeline in offline/mock mode)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Auth
JWT_SECRET=change-me-in-production
JWT_EXPIRE_MINUTES=720
DEMO_USERNAME=demo
DEMO_PASSWORD=veritas

# Storage / app
STORAGE_DIR=./uploads
CORS_ORIGINS=http://localhost:3000
ENVIRONMENT=development
